# ==============================================================================
# Olith Banking Environment Configuration Template
# ==============================================================================

# Server & Environment
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000

# Authentication & Sessions
JWT_SECRET=your_long_random_jwt_secret_here
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=olith_session
ELEVATED_COOKIE_NAME=olith_elevated_session
ELEVATED_SESSION_MINUTES=15

# Database (Supabase PostgreSQL) - Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Legacy MySQL Database (Optional fallback)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=olith_banking
DB_USER=olith_app
DB_PASSWORD=your_db_password_here

# Stripe Financial Connections & Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Email Verification & SMTP Settings
# Set to 'false' for instant signup without email confirmation, or 'true' to require email verification
EMAIL_VERIFY_REQUIRED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@olithbanking.com
